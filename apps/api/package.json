{
  "name": "@saytumbay/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API SaytuMbay : authentification, cloisonnement par organisation, mesures, alertes, console.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --clear-screen=false src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed-cli.ts",
    "openapi": "tsx src/openapi-cli.ts",
    "bootstrap": "tsx src/db/bootstrap-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "@saytumbay/shared": "*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "mqtt": "5.16.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
